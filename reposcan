
# reposcan - Simple wrapper script for quick scanning

#!/usr/bin/env bash

# Function to display help
show_help() {
    cat << EOF
repoScanner - Repository Analysis Tool

USAGE:
    ./reposcan <path> [--raw|--dev|--stats|--help]

ARGUMENTS:
    <path>          Directory path to scan (required)
    --stats         Show summary statistics (default)
    --raw, --dev    Show detailed file-by-file analysis with dependency tree
    --bench         Show tool performance details
    --help, -h      Show this help message

EXAMPLES:
    # Scan current directory in stats mode
    ./reposcan .

    # Scan a specific path
    ./reposcan /path/to/repo

    # Show detailed analysis (tree with file dependencies)
    ./reposcan /path/to/repo --raw
    ./reposcan /path/to/repo --dev    # Same as --raw

    # Scan in explicit stats mode
    ./reposcan /path/to/repo --stats

    # Show tool performance data
    ./reposcan --bench

OUTPUT:
    Results are displayed in the terminal and saved (except benchmarking data) to output/report.json

EOF
}

# Check if no arguments or help flag provided
if [ $# -eq 0 ] || [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# Benchmark suite execution
if [ "$1" == "--bench" ]; then
    python3 tests/benchmark.py
    exit 0
fi

# Parse arguments order-independently: the first non-flag is the path,
# the recognized flag (if any) is the mode. This avoids assuming a fixed
# position, so "./reposcan --raw" and "./reposcan <path> --raw" behave the
# same as the underlying "python3 -m repoScan.cli" command.
REPO_PATH="."
MODE="--stats"  # Default to --stats if no mode flag is given

for arg in "$@"; do
    case "$arg" in
        --raw|--dev)   MODE="--raw" ;;   # --dev is an alias for --raw
        --stats|--nerd) MODE="--stats" ;;
        *)             REPO_PATH="$arg" ;;
    esac
done

# Run the scanner
python3 -m repoScan.cli "$REPO_PATH" "$MODE"